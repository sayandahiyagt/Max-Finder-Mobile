# Browser-safe Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Do not expose or commit these.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only PostgreSQL connection used by Prisma. Local development points to Supabase CLI.
DATABASE_URL=

# Vercel Preview and Production only. Base64-encoded Supabase PostgreSQL CA certificate.
SUPABASE_DB_CA_CERT_BASE64=
